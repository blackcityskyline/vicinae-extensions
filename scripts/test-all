#!/usr/bin/env bash
# Run `npm test` in every extension that declares one.
#
#   ./scripts/test-all                 all extensions
#   ./scripts/test-all cron-kit lastfm  only the named ones
#   ./scripts/test-all --install       run `npm ci` where node_modules is absent
#
# Vicinae has no test runner: an extension's test script is a plain program that
# exits non-zero on failure. This script only loops and reports.
set -uo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
install=0
names=()

for arg in "$@"; do
  case "$arg" in
    --install) install=1 ;;
    -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
    *) names+=("$arg") ;;
  esac
done

has_test() {
  [ -f "$1/package.json" ] && node -e '
    const s = require(process.argv[1]).scripts;
    process.exit(s && s.test ? 0 : 1);
  ' "$1/package.json" 2>/dev/null
}

if [ ${#names[@]} -eq 0 ]; then
  for dir in "$repo_root"/*/; do
    dir="${dir%/}"
    has_test "$dir" && names+=("$(basename "$dir")")
  done
fi

failed=()
skipped=()
for name in "${names[@]}"; do
  dir="$repo_root/$name"
  if [ ! -d "$dir" ]; then
    echo "FAIL $name: no such extension" >&2
    failed+=("$name")
    continue
  fi
  if ! has_test "$dir"; then
    echo "SKIP $name: no test script"
    skipped+=("$name")
    continue
  fi
  if [ ! -d "$dir/node_modules" ]; then
    if [ "$install" -eq 1 ]; then
      echo "---- $name: npm ci"
      ( cd "$dir" && npm ci --silent ) || { failed+=("$name"); continue; }
    else
      echo "SKIP $name: node_modules missing (use --install)"
      skipped+=("$name")
      continue
    fi
  fi
  echo "---- $name"
  if ( cd "$dir" && npm test --silent ); then
    continue
  fi
  failed+=("$name")
done

echo
echo "passed: $(( ${#names[@]} - ${#failed[@]} - ${#skipped[@]} )), failed: ${#failed[@]}, skipped: ${#skipped[@]}"
if [ ${#failed[@]} -gt 0 ]; then
  printf 'failed: %s\n' "${failed[*]}"
  exit 1
fi
