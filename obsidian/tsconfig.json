{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["src/**/*", "vicinae-env.d.ts"],
  "compilerOptions": {
    "lib": ["es2020", "ES2021.String"],
    "module": "commonjs",
    "target": "es2020",
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
