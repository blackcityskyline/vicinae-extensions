{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "timer",
  "title": "Timer",
  "description": "Background timers with a note, an alarm, presets, and music while they run.",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "platforms": [
    "Linux"
  ],
  "author": "HarshNarayanJha",
  "contributors": [
    "alessandrobelli"
  ],
  "pastContributors": [],
  "icon": "icon.png",
  "commands": [
    {
      "name": "index",
      "title": "Start Timer",
      "description": "Start a timer, pick a preset, and choose the music that plays while it runs.",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "presets",
      "type": "textfield",
      "required": false,
      "title": "Timer Presets",
      "description": "Comma-separated presets (e.g., 5m Tea, 25m Pomodoro)",
      "default": "5m Tea, 25m Pomodoro"
    },
    {
      "name": "soundRepeat",
      "type": "dropdown",
      "required": false,
      "title": "Sound Repeat",
      "description": "How many times to play the timer sound",
      "default": "once",
      "data": [
        {
          "title": "Once",
          "value": "once"
        },
        {
          "title": "Repeat until disabled",
          "value": "until_disabled"
        }
      ]
    },
    {
      "name": "musicVolume",
      "type": "textfield",
      "required": false,
      "title": "Music Volume",
      "description": "mpv volume while the music plays, 0 to 100.",
      "placeholder": "60",
      "default": "60"
    }
  ],
  "scripts": {
    "build": "vici build",
    "dev": "vici develop",
    "lint": "vici lint",
    "check": "tsc --noEmit -p tsconfig.json --noUnusedLocals",
    "test": "tsx test/timer.test.ts"
  },
  "dependencies": {
    "@vicinae/api": "^0.22.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
