{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "shell-history",
  "title": "Shell History",
  "description": "Search the zsh, bash and fish command history. Secrets are masked in the list; what you copy is the real command.",
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "platforms": [
    "Linux"
  ],
  "author": "black",
  "contributors": [
    "koinzhang",
    "xmok"
  ],
  "pastContributors": [],
  "icon": "extension_icon.png",
  "commands": [
    {
      "name": "history",
      "title": "Search History",
      "description": "Search commands from zsh, bash and fish, newest first, with a shell filter.",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "terminal",
      "title": "Terminal",
      "description": "Which terminal to open for Ctrl+X. Auto uses xdg-terminal-exec when installed, otherwise the first of these found on PATH.",
      "type": "dropdown",
      "required": false,
      "default": "auto",
      "data": [
        {
          "title": "Auto",
          "value": "auto"
        },
        {
          "title": "foot",
          "value": "foot"
        },
        {
          "title": "kitty",
          "value": "kitty"
        },
        {
          "title": "alacritty",
          "value": "alacritty"
        },
        {
          "title": "wezterm",
          "value": "wezterm"
        },
        {
          "title": "ghostty",
          "value": "ghostty"
        },
        {
          "title": "gnome-terminal",
          "value": "gnome-terminal"
        },
        {
          "title": "konsole",
          "value": "konsole"
        },
        {
          "title": "mate-terminal",
          "value": "mate-terminal"
        },
        {
          "title": "terminator",
          "value": "terminator"
        },
        {
          "title": "xfce4-terminal",
          "value": "xfce4-terminal"
        },
        {
          "title": "xterm",
          "value": "xterm"
        },
        {
          "title": "lxterminal",
          "value": "lxterminal"
        },
        {
          "title": "urxvt",
          "value": "urxvt"
        },
        {
          "title": "st",
          "value": "st"
        }
      ]
    },
    {
      "name": "dateFormat",
      "title": "Date Format",
      "description": "How timestamps are written in the list. Always 24-hour, and never the machine's locale.",
      "type": "dropdown",
      "required": false,
      "default": "dotted",
      "data": [
        {
          "title": "dotted  (10.03.2026 04:59)",
          "value": "dotted"
        },
        {
          "title": "dmy  (10/03/2026 04:59)",
          "value": "dmy"
        },
        {
          "title": "mdy  (03/10/2026 04:59)",
          "value": "mdy"
        },
        {
          "title": "iso  (2026-03-10 04:59)",
          "value": "iso"
        }
      ]
    },
    {
      "name": "maxEntries",
      "title": "History Entries",
      "description": "How many entries per shell to keep in the list. More entries means slower opening.",
      "type": "dropdown",
      "required": false,
      "default": "1000",
      "data": [
        {
          "title": "500",
          "value": "500"
        },
        {
          "title": "1000",
          "value": "1000"
        },
        {
          "title": "2500",
          "value": "2500"
        },
        {
          "title": "5000",
          "value": "5000"
        }
      ]
    }
  ],
  "scripts": {
    "build": "vici build",
    "dev": "vici develop",
    "lint": "vici lint",
    "check": "tsc --noEmit -p tsconfig.json --noUnusedLocals",
    "test": "tsx test/history.test.ts && tsx test/time.test.ts && tsx test/terminals.test.ts"
  },
  "dependencies": {
    "@vicinae/api": "^0.29.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
