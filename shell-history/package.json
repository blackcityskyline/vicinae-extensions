{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "shell-history",
  "title": "Shell History",
  "description": "Search the zsh, bash and fish command history. Secrets are masked in the list; what you copy is the real command.",
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "platforms": [
    "Linux"
  ],
  "author": "black",
  "contributors": [
    "koinzhang",
    "xmok"
  ],
  "pastContributors": [],
  "icon": "extension_icon.png",
  "commands": [
    {
      "name": "history",
      "title": "Search History",
      "description": "Search commands from zsh, bash and fish, newest first, with a shell filter.",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "terminal",
      "title": "Terminal",
      "description": "Which terminal to open for Ctrl+Enter. Auto uses xdg-terminal-exec when installed, otherwise the first of these found on PATH.",
      "type": "dropdown",
      "required": false,
      "default": "auto",
      "data": [
        {
          "title": "Auto",
          "value": "auto"
        },
        {
          "title": "foot",
          "value": "foot"
        },
        {
          "title": "kitty",
          "value": "kitty"
        },
        {
          "title": "alacritty",
          "value": "alacritty"
        },
        {
          "title": "wezterm",
          "value": "wezterm"
        },
        {
          "title": "ghostty",
          "value": "ghostty"
        },
        {
          "title": "gnome-terminal",
          "value": "gnome-terminal"
        },
        {
          "title": "konsole",
          "value": "konsole"
        },
        {
          "title": "xfce4-terminal",
          "value": "xfce4-terminal"
        },
        {
          "title": "xterm",
          "value": "xterm"
        }
      ]
    }
  ],
  "scripts": {
    "build": "vici build",
    "dev": "vici develop",
    "lint": "vici lint",
    "check": "tsc --noEmit -p tsconfig.json --noUnusedLocals",
    "test": "tsx test/history.test.ts && tsx test/terminals.test.ts"
  },
  "dependencies": {
    "@vicinae/api": "^0.29.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
