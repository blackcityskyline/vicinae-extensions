{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "ffmpeg",
  "title": "FFmpeg",
  "description": "Inspect media with ffprobe, convert, merge and edit it with the system ffmpeg, with presets and a persistent queue.",
  "categories": [
    "Media",
    "Productivity",
    "Developer Tools"
  ],
  "license": "MIT",
  "platforms": [
    "Linux"
  ],
  "author": "black",
  "contributors": [
    "leandro.maia",
    "wattmalsh",
    "samuelkraft",
    "sacha_crispin",
    "chihkang",
    "tomjohn"
  ],
  "pastContributors": [],
  "icon": "icon.png",
  "commands": [
    {
      "name": "media-info",
      "title": "Media Info",
      "subtitle": "FFmpeg",
      "description": "Pick media files, read their streams, preview a frame, rotate or convert them with ffmpeg.",
      "mode": "view"
    },
    {
      "name": "convert",
      "title": "Convert Media",
      "subtitle": "FFmpeg",
      "description": "Converts a media file to a different file format",
      "mode": "view"
    },
    {
      "name": "merge",
      "title": "Merge Media",
      "subtitle": "FFmpeg",
      "description": "Concatenate multiple video or audio files into a single output file",
      "mode": "view"
    },
    {
      "name": "history",
      "title": "View Conversion History",
      "subtitle": "FFmpeg",
      "description": "Browse, re-run or clear your recent conversions",
      "mode": "view"
    },
    {
      "name": "presets",
      "title": "Manage Presets",
      "subtitle": "FFmpeg",
      "description": "Create, edit and delete conversion presets",
      "mode": "view"
    },
    {
      "name": "inspect",
      "title": "Inspect Media",
      "subtitle": "FFmpeg",
      "description": "Inspect codecs, streams, dimensions, bitrate and metadata",
      "mode": "view"
    },
    {
      "name": "queue",
      "title": "Conversion Queue",
      "subtitle": "FFmpeg",
      "description": "Run, monitor, cancel and retry queued conversions",
      "mode": "view"
    },
    {
      "name": "edit",
      "title": "Edit Media",
      "subtitle": "FFmpeg",
      "description": "Resize, crop, change speed or frame rate, remove or extract audio, normalize loudness, or edit subtitles",
      "mode": "view"
    }
  ],
