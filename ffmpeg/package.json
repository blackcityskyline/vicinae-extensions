  "scripts": {
    "build": "vici build",
    "dev": "vici develop",
    "lint": "vici lint",
    "check": "tsc --noEmit -p tsconfig.json --noUnusedLocals",
    "test": "tsx test/ffmpeg.test.ts && node --import tsx --import ./test/register.mjs --test \"test/unit/**/*.test.ts\""
  },
  "dependencies": {
    "@raycast/utils": "^2.3.2",
    "@vicinae/api": "^0.29.0"
  },
  "devDependencies": {
