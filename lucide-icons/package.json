{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "lucide-icons",
  "title": "Lucide Icons",
  "description": "Search the Lucide icon set and copy the name, the SVG or the component tag.",
  "categories": [
    "Design Tools",
    "Developer Tools"
  ],
  "license": "MIT",
  "platforms": [
    "Linux"
  ],
  "author": "black",
  "contributors": [
    "Sn0wye",
    "lin",
    "xilopaint",
    "ridemountainpig",
    "j3lte",
    "muhammadrizo"
  ],
  "pastContributors": [],
  "icon": "command-icon.png",
  "commands": [
    {
      "name": "search",
      "title": "Search Icons",
      "subtitle": "Lucide",
      "description": "Grid view of Lucide icons",
      "mode": "view",
      "preferences": [
        {
          "name": "primaryAction",
          "type": "dropdown",
          "required": false,
          "title": "Primary Action",
          "description": "Primary action to use",
          "default": "copy-name",
          "data": [
            {
              "title": "Copy Name",
              "value": "copy-name"
            },
            {
              "title": "Copy SVG",
              "value": "copy-svg"
            },
            {
              "title": "Paste SVG",
              "value": "paste-svg"
            },
            {
              "title": "Copy Component",
              "value": "copy-component"
            },
            {
              "title": "Open In Browser",
              "value": "open-in-browser"
            }
          ]
        },
        {
          "name": "pascalCaseName",
          "title": "Copy Icon Name",
          "label": "Copy name in Pascal Case",
          "description": "Copy the icon name using Pascal case (e.g., 'LucideIconName').",
          "type": "checkbox",
          "required": false,
          "default": false
        }
      ]
    }
  ],
  "preferences": [],
  "scripts": {
    "build": "vici build",
    "dev": "vici develop",
    "lint": "vici lint",
    "check": "tsc --noEmit -p tsconfig.json --noUnusedLocals",
    "test": "tsx --tsconfig tsconfig.test.json test/icons.test.ts"
  },
  "dependencies": {
    "@raycast/api": "^1.103.5"
  },
  "devDependencies": {
    "@raycast/api": "^1.103.5",
    "@vicinae/api": "^0.29.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
