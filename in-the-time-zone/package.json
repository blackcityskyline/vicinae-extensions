{
  "$schema": "https://www.schemastore.org/vicinae-extension.json",
  "name": "in-the-time-zone",
  "title": "In the Timezone",
  "description": "See and scrub the time across several cities at once.",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "platforms": [
    "Linux"
  ],
  "author": "black",
  "contributors": [
    "raycast",
    "i_idz"
  ],
  "icon": "icon.png",
  "commands": [
    {
      "name": "in-the-time-zone",
      "title": "In the Timezone",
      "description": "Scrub time across time zones",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "defaultScrubMinutes",
      "type": "dropdown",
      "title": "Arrow Key Scrub Minutes",
      "description": "Arrow keys (left, right) scrub time by this many minutes.",
      "data": [
        {
          "title": "5 Minutes",
          "value": "5"
        },
        {
          "title": "10 Minutes",
          "value": "10"
        },
        {
          "title": "15 Minutes",
          "value": "15"
        },
        {
          "title": "30 Minutes",
          "value": "30"
        },
        {
          "title": "60 Minutes",
          "value": "60"
        }
      ],
      "default": "60",
      "required": false
    },
    {
      "name": "optionScrubMinutes",
      "type": "dropdown",
      "title": "Alt+Arrow Key Scrub Minutes",
      "description": "Alt with the arrow keys scrubs time by this many minutes.",
      "data": [
        {
          "title": "5 Minutes",
          "value": "5"
        },
        {
          "title": "10 Minutes",
          "value": "10"
        },
        {
          "title": "15 Minutes",
          "value": "15"
        },
        {
          "title": "30 Minutes",
          "value": "30"
        },
        {
          "title": "60 Minutes",
          "value": "60"
        }
      ],
      "default": "30",
      "required": false
    }
  ],
  "scripts": {
    "build": "vici build",
    "dev": "vici develop",
    "lint": "vici lint",
    "check": "tsc --noEmit -p tsconfig.json --noUnusedLocals",
    "test": "tsx test/time.test.ts && tsx test/zones.test.ts && tsx test/timeline.test.ts && tsx test/cities.test.ts"
  },
  "dependencies": {
    "@vicinae/api": "^0.29.0",
    "city-timezones": "^1.3.4",
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/suncalc": "^1.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
